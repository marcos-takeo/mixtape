# Copy this file to .env (or .env.local) and fill in your own values.
# This is a ONE-TIME setup done by whoever builds/deploys this app — end
# users of the deployed app never see or need this. See README.md ->
# "Google Drive setup" for how to get a Client ID.

# Read by the BROWSER bundle, baked in at build time (`vite build`). Needed
# for "Connect Google Drive" to work at all, sync or no sync. On Vercel,
# adding/changing this requires a redeploy — it's compiled into the static
# files, not read at request time.
VITE_GOOGLE_CLIENT_ID=

# Read by the SERVER (api/playlists.js) at request time, for the sync
# feature only — see README.md -> "Sync (playlists across devices)". Same
# value as VITE_GOOGLE_CLIENT_ID above, different variable, different job:
# this is what lets the server verify a token was actually issued for THIS
# app, not just trust the client's say-so.
GOOGLE_CLIENT_ID=

# Read by the SERVER (api/playlists.js), for the sync feature only. See
# the Supabase setup steps in README.md -> "Sync (playlists across
# devices)" for how to get this.
DATABASE_URL=
